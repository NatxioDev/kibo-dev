NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor (nunca NEXT_PUBLIC_). Supabase → Project Settings → API Keys → Secret keys.
# Se usa para cambiar el @username respetando el límite de días.
SUPABASE_SECRET_KEY=

# Web Push. Opcional: la pública v1 ya viene por defecto en el código
# (src/features/notifications/domain/vapidKey.ts), así que solo se define acá
# para probar otro par. La privada vive solo en Supabase secrets
# (VAPID_KEYS_JWK); nunca la pongas acá ni con prefijo NEXT_PUBLIC_.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Días que deben pasar entre cambios de @username (0 = sin límite). Por defecto 30.
# USERNAME_CHANGE_COOLDOWN_DAYS=30

# Opcional: override de versión mostrada en Settings (por defecto lee package.json)
# NEXT_PUBLIC_APP_VERSION=0.1.0

# Opcional. Protege GET/POST /api/cron/purge-payment-qr, que borra archivos de QR
# huérfanos o de cuentas eliminadas. Sin esta variable la ruta responde 404.
# CRON_SECRET=
