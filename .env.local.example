NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor (nunca NEXT_PUBLIC_). Supabase → Project Settings → API Keys → Secret keys.
# Se usa para cambiar el @username respetando el límite de días.
SUPABASE_SECRET_KEY=

# Días que deben pasar entre cambios de @username (0 = sin límite). Por defecto 30.
# USERNAME_CHANGE_COOLDOWN_DAYS=30

# Opcional: override de versión mostrada en Settings (por defecto lee package.json)
# NEXT_PUBLIC_APP_VERSION=0.1.0
